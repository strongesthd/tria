DATABASE_URL="postgresql://tria:${TRIA_DB_PASSWORD}@localhost:5433/tria_coffee?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret (32+ bytes hex: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\")"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
