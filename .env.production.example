# Required: generate before first deploy
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-random-64-char-hex"

# Database (compose interpolates these into postgres + app)
POSTGRES_USER=tria
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=tria_coffee
DATABASE_URL="postgresql://tria:replace-with-strong-password@db:5432/tria_coffee?schema=public"

# Trust the Cloudflare proxy so NextAuth sets secure cookies correctly.
AUTH_URL="https://triacafe.vn"
AUTH_TRUST_HOST=true

# OAuth (optional — leave blank to hide login buttons)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Public origin (used by sitemap, canonical URLs, Open Graph)
NEXT_PUBLIC_SITE_URL="https://triacafe.vn"
