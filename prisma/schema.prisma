generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  CAFE_OWNER
  TRIA_BARISTA
  TRIA_TECH
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(MEMBER)
  badge         String    @default("Newbie Brewer")
  triaPoints    Int       @default(0)
  accounts      Account[]
  sessions      Session[]
  posts         CommunityPost[]
  comments      Comment[]
  votes         PostVote[]
  registrations WorkshopRegistration[]
  bookings      Booking[]
  orders        Order[]
  contactMessages ContactMessage[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  target      String
  price       Int
  unit        String
  roastLevel  String?
  notes       String
  description String   @db.Text
  image       String
  images      String[] @default([])
  rating      Float    @default(0)
  reviews     Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]

  @@index([category, active])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  hours     String
  phone     String
  features  String[]
  image     String
  images    String[] @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         String      @id @default(cuid())
  userId     String
  status     String      @default("NEW")
  total      Int
  name       String
  phone      String
  address    String      @db.Text
  note       String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      OrderItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  unitPrice Int
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String?
  phone     String?
  subject   String?
  content   String   @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
}

/// One vote per user per post. Re-voting flips direction, never duplicates.
model PostVote {
  postId    String
  userId    String
  direction Int // 1 = up, -1 = down
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, userId])
  @@index([userId])
}

model Workshop {
  id             String                @id @default(cuid())
  title          String
  locationId     String
  startsAt       DateTime
  capacity       Int
  registrations  WorkshopRegistration[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model WorkshopRegistration {
  workshopId String
  userId     String
  createdAt  DateTime    @default(now())
  workshop   Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workshopId, userId])
  @@index([userId])
}

model Booking {
  id         String    @id @default(cuid())
  userId     String
  locationId String
  type       String
  date       DateTime
  note       String?
  status     String    @default("NEW")
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model PartnershipLead {
  id                String   @id @default(cuid())
  fullName          String
  phone             String
  partnershipType   String
  location          String
  notes             String?  @db.Text
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CommunityPost {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  image     String?   @db.Text
  category  String
  tags      String[]
  solved    Boolean   @default(false)
  upvotes   Int       @default(0)
  downvotes Int       @default(0)
  views     Int       @default(0)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
  votes     PostVote[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Comment {
  id         String        @id @default(cuid())
  content    String        @db.Text
  image      String?       @db.Text
  accepted   Boolean       @default(false)
  authorId   String
  postId     String
  parentId   String?
  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent     Comment?      @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies    Comment[]     @relation("CommentThread")
  createdAt  DateTime      @default(now())
}
